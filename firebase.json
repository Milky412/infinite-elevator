{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/stages/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=604800,stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/start-screen-*.webp",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=2592000,immutable"
          }
        ]
      },
      {
        "source": "/start-menu-bgm-*.mp3",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=2592000,immutable"
          }
        ]
      }
    ]
  }
}
