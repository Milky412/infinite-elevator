rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validRankingWrite(rankingId) {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.playerId is string
        && request.resource.data.playerId == rankingId
        && request.resource.data.playerId.size() >= 12
        && request.resource.data.playerId.size() <= 80
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 100000000
        && request.resource.data.floor == request.resource.data.score
        && request.resource.data.money is int
        && request.resource.data.money >= 0
        && request.resource.data.money <= 1000000000
        && request.resource.data.luck is int
        && request.resource.data.luck >= -1000000
        && request.resource.data.luck <= 1000000
        && request.resource.data.keys().hasOnly(['uid','playerId','name','score','floor','money','luck','createdAt']);
    }

    function validRankingCreate(rankingId) {
      return validRankingWrite(rankingId);
    }

    function validRankingUpdate(rankingId) {
      return validRankingWrite(rankingId)
        && request.resource.data.score >= resource.data.score;
    }

    // 総合ランキング: ゲーム専用playerIdごとの自己ベスト1件のみ。
    // Firebase匿名UIDが変わっても、端末に残るplayerIdで同じ記録を更新できる。
    match /rankings/{rankingId} {
      allow read: if true;
      allow create: if validRankingCreate(rankingId);
      allow update: if validRankingUpdate(rankingId);
      allow delete: if request.auth != null;
    }

    // 月間ランキング: 月ごとにplayerId単位の自己ベスト1件のみ。
    match /rankingsMonthly/{monthKey}/entries/{rankingId} {
      allow read: if true;
      allow create: if validRankingCreate(rankingId);
      allow update: if validRankingUpdate(rankingId);
      allow delete: if request.auth != null;
    }



    // 2〜4人用オンライン対戦ルーム。3桁コードを共有して参加する。
    function battlePlayer(data) {
      return request.auth != null
        && data.players is map
        && ((('p1' in data.players) && data.players.p1.uid == request.auth.uid)
          || (('p2' in data.players) && data.players.p2.uid == request.auth.uid)
          || (('p3' in data.players) && data.players.p3.uid == request.auth.uid)
          || (('p4' in data.players) && data.players.p4.uid == request.auth.uid));
    }

    match /battleRooms/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.maxPlayers in [2, 3, 4]
        && request.resource.data.status == 'waiting'
        && battlePlayer(request.resource.data);
      allow update: if request.auth != null
        && (battlePlayer(resource.data)
          || battlePlayer(request.resource.data)
          || resource.data.status == 'finished'
          || resource.data.status == 'cancelled'
          || (resource.data.createdAt is timestamp && resource.data.createdAt < request.time - duration.value(2, 'h')));
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    // v78以降はrankingMetaを使用しない。旧ドキュメントは残っていても参照しない。
    match /rankingMeta/{metaId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
